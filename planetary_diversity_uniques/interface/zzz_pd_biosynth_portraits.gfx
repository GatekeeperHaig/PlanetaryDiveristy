	# Council view renders every councilor through this hologram-projection type, which vanilla gives no alternate_configurations.
	# The holo variant keeps the projection shimmer in green for Biosynthetic councilors, and the config is trait-gated so other empires are unaffected.
	portraitType = {
		name = "GFX_portrait_character_hologram"
		texturefile = "gfx/interface/main/unselected_portrait.dds"
		masking_texture = "gfx/interface/leaders/portrait_mask_fade.dds"
		effectFile = "gfx/FX/buttonstate_rendertarget_hologram.shader"
		type = character
